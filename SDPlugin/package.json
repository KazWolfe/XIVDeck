{
  "name": "@kazwolfe/xivdeck-sdplugin",
  "version": "0.5.0",
  "private": true,
  "license": "MPL",
  "packageManager": "pnpm@11.24.0",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "build-release": "vite build && webpack --mode production && streamdeck pack dist/dev.wolf.xivdeck.sdPlugin -o dist -f --no-update-check",
    "build": "vite build && webpack --mode development",
    "watch": "concurrently \"vite build --watch\" \"webpack --mode development --watch --progress\"",
    "link": "streamdeck link dist/dev.wolf.xivdeck.sdPlugin",
    "dev": "streamdeck dev",
    "check": "tsc --noEmit -p . && svelte-check --workspace propertyInspector --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.0",
    "@elgato/utils": "^0.6.0",
    "@msgpack/msgpack": "^3.1.3",
    "@xmldom/xmldom": "^0.9.12",
    "i18next": "^26.4.2",
    "inversify": "^8.2.3",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "copy-webpack-plugin": "^14.0.0",
    "source-map-loader": "^5.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}
