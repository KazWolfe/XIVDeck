<Project Sdk="Microsoft.VisualStudio.JavaScript.SDK/1.0.6578810">
	<PropertyGroup>
		<TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
		<TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
		<IsPackable>false</IsPackable>

		<ShouldRunNpmInstall>false</ShouldRunNpmInstall>
	</PropertyGroup>
	<PropertyGroup>
		<JavaScriptTestRoot>test/</JavaScriptTestRoot>
		<JavaScriptTestFramework>Jest</JavaScriptTestFramework>
		<BuildCommand>pnpm run build</BuildCommand>
		<ProductionBuildCommand>pnpm run build-release</ProductionBuildCommand>
		<BuildOutputFolder>dist/</BuildOutputFolder>
	</PropertyGroup>
	<ItemGroup>
		<Script Include="src/**;build/**" Exclude="*.esproj;**/node_modules/**" />
        <Script Include="propertyInspector/**" Exclude="*.esproj;**/node_modules/**" />
		<None Include="assets/**" />
		<None Include="LICENSE;package.json;pnpm-workspace.yaml;tsconfig.json;vite.config.ts;webpack.config.ts" />
	</ItemGroup>
</Project>
